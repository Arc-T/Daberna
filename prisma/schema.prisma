generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum MatchStatus {
  WAITING
  STARTED
  LINE_COMPLETED
  COMPLETED
  CANCELLED
}

enum PlayerMatchResult {
  PENDING
  LINE_WINNER
  FULL_HOUSE_WINNER
  BOTH_WINNER
  LOST
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  GAME_ENTRY
  WINNING
  REFERRAL_REWARD
  GIFT
  BOT_WINNING
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED_FRAUD
  REJECTED_MISMATCH
  PAID
}

enum ReferralStatus {
  PENDING
  AWARDED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────

model User {
  id                  String   @id @default(cuid())
  username            String   @unique
  inviteCode          String   @unique
  email               String?
  phoneNumber         String?  @unique
  password            String?
  fullName            String?
  isGuest             Boolean  @default(true)
  isNewPlayer         Boolean  @default(true)
  completedGames      Int      @default(0)
  credit              Decimal  @default(0) @db.Decimal(15, 2)
  withdrawableBalance Decimal  @default(0) @db.Decimal(15, 2)
  referralRewardUsed  Boolean  @default(false)
  referrerId          String?
  shebaNumber         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  referrer               User?               @relation("UserReferrals", fields: [referrerId], references: [id])
  referredUsers          User[]              @relation("UserReferrals")
  playerMatches          PlayerMatch[]
  transactions           Transaction[]
  withdrawalRequests     WithdrawalRequest[]
  referralsAsReferrer    Referral[]          @relation("Referrer")
  referralsAsReferred    Referral?           @relation("ReferredUser")
  lineWinnerMatches      Match[]             @relation("LineWinner")
  fullHouseWinnerMatches Match[]             @relation("FullHouseWinner")
  notifications          Notification[]

  @@index([username])
  @@index([inviteCode])
  @@index([phoneNumber])
  @@index([isGuest])
  @@index([isNewPlayer])
}

// ─────────────────────────────────────────────────────────────
// Room
// ─────────────────────────────────────────────────────────────

model Room {
  id         String   @id @default(cuid())
  name       String   @unique
  entryFee   Decimal  @db.Decimal(15, 2)
  minCards   Int      @default(1)
  maxCards   Int      @default(4)
  isActive   Boolean  @default(true)
  botEnabled Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  matches Match[]

  @@index([isActive])
  @@index([entryFee])
}

// ─────────────────────────────────────────────────────────────
// Card
//
// Static data — a fixed set of 15 numbers + layout.
// Cards are picked per-match from this table.
// No "usedInMatch" flag: cards are reusable across matches.
// ─────────────────────────────────────────────────────────────

model Card {
  id        String   @id @default(cuid())
  numbers   Json // [15 unique numbers], sorted per column
  layout    Json // { rows: number[], cols: number[] } per number index
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  matchCards MatchCard[]

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────
// Match
//
// NOTE: lineWinnerId / fullHouseWinnerId are kept for the
// "single winner" case. When there's a tie, the prize is split
// and both winners get MatchWinner rows (see below).
// ─────────────────────────────────────────────────────────────

model Match {
  id                String      @id @default(cuid())
  roomId            String
  roomEntryFee      Decimal     @db.Decimal(15, 2)
  status            MatchStatus @default(WAITING)
  totalCards        Int         @default(0)
  startTime         DateTime?
  endTime           DateTime?
  calledNumbers     Json? // ordered array of called numbers
  lineWinnerId      String?
  linePrize         Decimal?    @db.Decimal(15, 2)
  fullHouseWinnerId String?
  fullHousePrize    Decimal?    @db.Decimal(15, 2)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // ── Money fields — all required, snapshot of the match's economics
  platformCut   Decimal @default(0) @db.Decimal(15, 2) // 10% commission
  linePool      Decimal @default(0) @db.Decimal(15, 2) // 10% line prize pool
  fullHousePool Decimal @default(0) @db.Decimal(15, 2) // 80% full-house pool
  botWinnings   Decimal @default(0) @db.Decimal(15, 2) // accumulated bot wins

  // Relations
  room            Room          @relation(fields: [roomId], references: [id])
  lineWinner      User?         @relation("LineWinner", fields: [lineWinnerId], references: [id])
  fullHouseWinner User?         @relation("FullHouseWinner", fields: [fullHouseWinnerId], references: [id])
  playerMatches   PlayerMatch[]
  matchNumbers    MatchNumber[]
  matchCards      MatchCard[]

  @@index([roomId])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// PlayerMatch
//
// A player's participation in one match.
// Cards are linked via MatchCard.assignedTo.
// ─────────────────────────────────────────────────────────────

model PlayerMatch {
  id              String            @id @default(cuid())
  matchId         String
  userId          String?
  cardCount       Int
  entryAmount     Decimal           @db.Decimal(15, 2)
  isBot           Boolean           @default(false)
  botUsername     String?
  botStats        Json? // { games, lineWins, fullHouseWins }
  result          PlayerMatchResult @default(PENDING)
  prizeAmount     Decimal?          @db.Decimal(15, 2)
  lineWinner      Boolean           @default(false)
  fullHouseWinner Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  match      Match       @relation(fields: [matchId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  matchCards MatchCard[]

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
  @@index([isBot])
  @@index([result])
}

// ─────────────────────────────────────────────────────────────
// MatchCard
//
// The per-match 100-card pool. Each Match has N cards (default 100).
// When a card is assigned to a player, `assignedTo` points to the
// PlayerMatch row.
//
// @@unique([matchId, cardId]) enforces "no duplicate card within
// a single match" — the exact rule from Daberna-2 (page 9).
// ─────────────────────────────────────────────────────────────

model MatchCard {
  id         String    @id @default(cuid())
  matchId    String
  cardId     String
  assignedTo String? // playerMatchId once assigned
  assignedAt DateTime?
  createdAt  DateTime  @default(now())

  match       Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  card        Card         @relation(fields: [cardId], references: [id])
  playerMatch PlayerMatch? @relation(fields: [assignedTo], references: [id])

  @@unique([matchId, cardId])
  @@index([matchId])
  @@index([cardId])
  @@index([assignedTo])
}

// ─────────────────────────────────────────────────────────────
// MatchNumber
// ─────────────────────────────────────────────────────────────

model MatchNumber {
  id         String   @id @default(cuid())
  matchId    String
  number     Int // 1–90
  calledAt   DateTime @default(now())
  orderIndex Int

  match Match @relation(fields: [matchId], references: [id])

  @@unique([matchId, number])
  @@index([matchId])
  @@index([number])
  @@index([orderIndex])
}

// ─────────────────────────────────────────────────────────────
// Transaction
// ─────────────────────────────────────────────────────────────

model Transaction {
  id            String            @id @default(cuid())
  userId        String?
  type          TransactionType
  amount        Decimal           @db.Decimal(15, 2)
  balanceBefore Decimal           @db.Decimal(15, 2)
  balanceAfter  Decimal           @db.Decimal(15, 2)
  status        TransactionStatus @default(PENDING)
  referenceId   String?
  description   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([referenceId])
}

// ─────────────────────────────────────────────────────────────
// WithdrawalRequest
// ─────────────────────────────────────────────────────────────

model WithdrawalRequest {
  id         String           @id @default(cuid())
  userId     String
  amount     Decimal          @db.Decimal(15, 2)
  iban       String
  fullName   String
  status     WithdrawalStatus @default(PENDING)
  adminNotes String?
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Referral
// ─────────────────────────────────────────────────────────────

model Referral {
  id                  String         @id @default(cuid())
  referrerId          String
  referredUserId      String         @unique
  rewardAmount        Decimal        @db.Decimal(15, 2)
  status              ReferralStatus @default(PENDING)
  firstPurchaseAmount Decimal?       @db.Decimal(15, 2)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  referrer     User @relation("Referrer", fields: [referrerId], references: [id])
  referredUser User @relation("ReferredUser", fields: [referredUserId], references: [id])

  @@index([referrerId])
  @@index([referredUserId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Bot
// ─────────────────────────────────────────────────────────────

model Bot {
  id        String   @id @default(cuid())
  username  String   @unique
  stats     Json // { games, lineWins, fullHouseWins }
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

enum NotificationType {
  DEPOSIT_SUCCESS
  DEPOSIT_FAILED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  PRIZE_RECEIVED
  MATCH_RESULT
  LINE_WIN
  FULL_HOUSE_WIN
  MATCH_ENDED
  REFERRAL_SUCCESS
  REFERRAL_REWARD
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// AdminLog
//
// Docs page 55, 62, 69.
// ─────────────────────────────────────────────────────────────

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Setting
// ─────────────────────────────────────────────────────────────

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}
